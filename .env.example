# Copy to .env and fill in. .env is gitignored.

# sqlx connection string. The file (and its parent dir) is created automatically.
DATABASE_URL=sqlite://data/nutrition.db

# Address the server binds to.
BIND_ADDR=127.0.0.1:3000

# IANA time zone used to compute local_date for daily-aggregated records.
USER_TZ=America/New_York

# Unit used when displaying body mass. Storage is always kg. One of: kg, lb
DISPLAY_MASS_UNIT=lb

# Argon2 PHC hash of your login password. Generate with:
#   cargo run -p server --bin hash-password -- 'your password here'
# Wrap it in single quotes: it contains `$`, and dotenvy expands `$NAME` in
# unquoted or double-quoted values. Single quotes disable that expansion.
APP_PASSWORD_HASH='$argon2id$v=19$...'

# >=64 random bytes, hex-encoded, used to sign the session cookie. Generate with:
#   openssl rand -hex 64
SESSION_SECRET=

# Bearer token the future Health Auto Export ingestion endpoint (M5) will require.
# Not used yet; set to any random string for now.
INGEST_TOKEN=
